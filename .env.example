# Copy to .env and fill in – never commit the real file.
# docker compose reads it automatically; without Docker, load it in your service manager.

# Required
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Where the site is reachable
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WISHLY_SITE_URL=http://localhost:8000
# true behind a reverse proxy with TLS (secure cookies)
DJANGO_BEHIND_HTTPS_PROXY=false
APP_PORT=8000

WISHLY_ALLOW_SIGNUP=true
WISHLY_BIRTHDAY_REMINDER_DAYS=14
WISHLY_AMAZON_TAG=

# Optional: admin account created on first start
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# E-mail (password reset, birthday reminders); without EMAIL_HOST mails only go to the log
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=wishly@example.org

# Only without Docker (compose sets these itself)
# POSTGRES_DB=wishly
# POSTGRES_USER=wishly
# POSTGRES_HOST=localhost
# CELERY_BROKER_URL=redis://localhost:6379/0
