# Copy to .env and load it in your service manager – never commit the real file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=wishly.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://wishly.example.org
DJANGO_BEHIND_HTTPS_PROXY=true
WISHLY_SITE_URL=https://wishly.example.org
WISHLY_ALLOW_SIGNUP=true

# PostgreSQL (leave POSTGRES_DB empty for SQLite in WISHLY_SQLITE_PATH)
POSTGRES_DB=wishly
POSTGRES_USER=wishly
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost

# Celery broker – without it tasks run inline in the web process
CELERY_BROKER_URL=redis://localhost:6379/0

# E-mail (password reset, birthday reminders); without EMAIL_HOST mails go to the console
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=wishly@example.org

WISHLY_BIRTHDAY_REMINDER_DAYS=14
WISHLY_AMAZON_TAG=
